NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_key

# Optional: override provider auto-detection. Supported values: openai | github-models
# AI_PROVIDER=openai

# OpenAI provider
OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GitHub Models provider
# Requires a token with access to GitHub Models endpoints.
# GITHUB_TOKEN=your_github_token
# GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
# GITHUB_MODELS_CHAT_MODEL=gpt-4.1-mini
# GITHUB_MODELS_EMBEDDING_MODEL=text-embedding-3-small
